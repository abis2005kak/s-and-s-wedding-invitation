<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <title>Hemnath & Hemasri — Wedding Invitation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Ballet&family=Cormorant+Garamond:wght@400;500;600;700&family=Great+Vibes&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./css/style.css" />
</head>
<body>
  <div id="opening" class="opening" aria-label="Wedding invitation opening">
    <video id="openingVideo" class="opening-video" playsinline preload="auto">
      <source src="./assets/opening.mp4" type="video/mp4" />
    </video>
    <div class="opening-shade"></div>
    <div class="opening-title">
      <div class="monogram">H&amp;H</div>
      <div class="opening-subtitle">Wedding Invitation</div>
    </div>
    <button id="sealButton" class="seal-button" aria-label="Tap the wax seal to open"></button>
    <div id="tapText" class="tap-text">Tap the seal to open</div>
  </div>

  <audio id="bgm" src="./assets/background.mp3" loop preload="auto"></audio>

  <div class="floating-decor" aria-hidden="true">
    <span class="petal p1">✦</span><span class="petal p2">✿</span><span class="petal p3">•</span>
    <span class="petal p4">✦</span><span class="petal p5">•</span><span class="petal p6">✿</span>
    <span class="petal p7">•</span><span class="petal p8">✦</span><span class="petal p9">✿</span>
  </div>

  <main id="invitation" class="invitation" aria-hidden="true">
    <section class="hero section reveal">
      <div class="ganesha-wrap">
        <img class="ganesha" src="https://pub-1953a6673e864f3488c645252f75de98.r2.dev/may/Hemadri%20%26%20Ravindra/GAnesha%20Icon.png" alt="Lord Ganesha" />
      </div>
      <p class="tamil-heading">திருமணம் அழைப்பிதழ்</p>
      <div class="kural">
        <p><span class="kural-line">அன்பும் அறனும் உடைத்தாயின் இல்வாழ்க்கை</span><span class="kural-line">பண்பும் பயனும் அது.</span></p>
        <span>— திருக்குறள் 45</span>
      </div>
      <p class="invite-copy">With the blessings of the Almighty and our beloved families,<br>we joyfully invite you to grace the wedding of</p>
      <div class="couple-block">
        <div class="person">
          <div class="couple-name">Hemnath</div>
          <div class="parent-line">S/o Mr. K. Ashok Kumar &amp; Mrs. A. Valarmathi</div>
        </div>
        <div class="ampersand">&amp;</div>
        <div class="person">
          <div class="couple-name">Hemasri</div>
          <div class="parent-line">D/o Mr. A. Rajendran &amp; Mrs. R. Jayanthi</div>
        </div>
      </div>
      <div class="scroll-cue">Scroll to Reveal <span>↓</span></div>
    </section>

    <section class="section date-section reveal">
      <p class="eyebrow">The Date</p>
      <h2>Save the Date</h2>
      <p class="section-intro">Scratch below to reveal our wedding date</p>
      <div class="reveal-grid">
        <button class="reveal-card" data-reveal aria-label="Scratch to reveal month">
          <div class="reveal-content"><span class="label">Month</span><strong>October</strong></div>
          <div class="scratch-cover"><span>Month</span><small>↑ SCRATCH</small></div>
        </button>
        <button class="reveal-card" data-reveal aria-label="Scratch to reveal day">
          <div class="reveal-content"><span class="label">Day</span><strong>30</strong></div>
          <div class="scratch-cover"><span>Day</span><small>↑ SCRATCH</small></div>
        </button>
        <button class="reveal-card" data-reveal aria-label="Scratch to reveal year">
          <div class="reveal-content"><span class="label">Year</span><strong>2026</strong></div>
          <div class="scratch-cover"><span>Year</span><small>↑ SCRATCH</small></div>
        </button>
      </div>
      <p class="date-line">A new chapter, woven with two hearts and the blessings of family</p>
      <p class="location-line">Thirumanam&nbsp; 30 · 10 · 2026 · Sathumadurai</p>
      <div id="countdown" class="countdown" aria-label="Countdown to wedding">
        <div><strong id="days">00</strong><span>Days</span></div>
        <div><strong id="hours">00</strong><span>Hours</span></div>
        <div><strong id="mins">00</strong><span>Mins</span></div>
        <div><strong id="secs">00</strong><span>Secs</span></div>
      </div>
      <div id="celebrationBurst" class="celebration-burst" aria-hidden="true"></div>
    </section>

    <section class="section story-section reveal">
      <p class="eyebrow">Our Story</p>
      <h2>Our Little<br>Story</h2>
      <p class="story-lead">Two hearts, two families, one beautiful beginning — and a new chapter waiting to unfold.</p>
      <div class="story-frame">
        <div id="storyTrack" class="story-track">
          <img src="./assets/story-01.png" alt="Our story — chapter 1" draggable="false">
          <img src="./assets/story-02.png" alt="Our story — chapter 2" draggable="false">
          <img src="./assets/story-03.png" alt="Our story — chapter 3" draggable="false">
          <img src="./assets/story-04.png" alt="Our story — chapter 4" draggable="false">
          <img src="./assets/story-05.png" alt="Our story — chapter 5" draggable="false">
        </div>
      </div>
      <div class="story-controls">
        <button id="storyPrev" class="story-btn" aria-label="Previous story photo">←</button>
        <div class="story-meta"><span id="storyCount">01 / 05</span><span>swipe or tap to continue</span></div>
        <button id="storyNext" class="story-btn" aria-label="Next story photo">→</button>
      </div>
    </section>

    <section class="section ceremonies reveal">
      <p class="eyebrow">The Celebrations Unfold</p>
      <h2>Sacred Ceremonies</h2>

      <article class="event-card">
        <div class="day-divider" aria-label="Day 1 Wedding"><span>Day 1</span><b>Wedding</b></div>
        <video class="event-video lazy-video" playsinline muted loop preload="metadata">
          <source src="./assets/wedding.mp4" type="video/mp4">
        </video>
        <div class="event-info-card wedding-info">
          <div class="event-kicker">Friday · 30 October 2026</div>
          <h3>Wedding</h3>
          <p class="event-time">5:30 AM onwards</p>
          <p class="venue">Sri Valli Deivanai Sametha Balasubramaniyar Temple<br>Sathumadurai, Vellore</p>
          <a class="map-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Sri%20Valli%20Deivanai%20Sametha%20Balasubramaniyar%20Temple%20Sathumadurai%20Vellore">⌖ &nbsp; View on Map</a>
          <div class="mini-schedule">
            <div><span>5:30 AM</span><b>Welcoming</b></div>
            <div><span>6:00 — 7:30 AM</span><b>Muhurtham</b></div>
            <div><span>8:00 AM</span><b>Blessings</b></div>
          </div>
        </div>
      </article>

      <article class="event-card">
        <div class="day-divider" aria-label="Day 2 Reception"><span>Day 2</span><b>Reception</b></div>
        <video class="event-video lazy-video" playsinline muted loop preload="metadata">
          <source src="./assets/reception.mp4" type="video/mp4">
        </video>
        <div class="event-info-card reception-info">
          <div class="event-kicker">Sunday · 1 November 2026</div>
          <h3>Reception</h3>
          <p class="event-time">From 6:30 PM onwards</p>
          <p class="venue">K.M Nathan Mahal<br>Tolgate, Vellore</p>
          <a class="map-link" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=K.M.%20Nathan%20Palace%20Thirumana%20Mandapam%20Tolgate%20Vellore">⌖ &nbsp; View on Map</a>
          <div class="mini-schedule">
            <div><span>6:30 PM</span><b>Welcoming</b></div>
            <div><span>7:00 PM</span><b>DJ</b></div>
            <div><span>7:30 PM</span><b>Feast</b></div>
          </div>
        </div>
      </article>
    </section>

    <section class="section closing reveal">
      <div class="om">ॐ</div>
      <p>Bound by sacred vows, blessed by two loving families, and graced by the Almighty —<br>we begin our forever with grateful, joyful hearts.</p>
      <p>We cannot wait to celebrate this beautiful chapter with you.</p>
      <div class="closing-names">Hemnath &amp; Hemasri</div>
    </section>

    <footer class="site-footer">
      <div class="footer-love">Made with love by</div>
      <a class="instagram-pill" href="https://www.instagram.com/craft_and_celebrate/" target="_blank" rel="noopener noreferrer" aria-label="Open @craft_and_celebrate on Instagram">
        <span class="instagram-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"/></svg>
        </span>
        <span>@craft_and_celebrate</span>
      </a>
    </footer>
  </main>

  <button id="musicToggle" class="music-toggle" type="button" aria-label="Turn music off" aria-pressed="true">
    <span class="music-icon" aria-hidden="true">♪</span>
    <span id="musicLabel">Music On</span>
  </button>

  <script src="./js/app.js"></script>
</body>
</html>
